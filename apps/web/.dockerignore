# Web build context = apps/web. Keep node_modules + .next out: node_modules is
# huge and host-arch-specific (the in-image `pnpm install` rebuilds it), and a
# stale local .next pollutes the production build.
node_modules/
.next/
out/

# Secrets / local env — never bake into the image
.env
.env.local
!.env.local.example

# Tests + their artifacts (not needed in the runtime image)
tests/
playwright-report/
test-results/
.playwright/

# VCS, IDE, build info, docs
.git/
*.md
tsconfig.tsbuildinfo
.eslintrc.json
