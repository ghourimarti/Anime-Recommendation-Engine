    {
      "type": "stat",
      "title": "Requests waiting",
      "description": "Queued because the KV cache or the batch is full. Sustained non-zero = the GPU is the bottleneck. Queries BOTH engines (vLLM colon names, SGLang underscore names) and shows whichever is live \u2014 only one holds the GPU at a time. Before this the row was vLLM-only and read blank whenever SGLang served.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
