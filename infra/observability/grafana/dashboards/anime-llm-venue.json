    {
      "type": "heatmap",
      "title": "Retrieval confidence distribution",
      "description": "Top-1 rerank relevance as a 0-1 probability, per request. The routing threshold is 1.0 in LOGIT space = 0.731 here: only the mass to the RIGHT of 0.731 can reach the venue. An empty panel means no confidence was produced at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(anime_retrieval_confidence_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64
        },
        "yAxis": {
          "unit": "short"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Confidence percentiles vs the 0.731 threshold",
      "description": "If p99 sits below the dashed threshold line, the venue will never be selected regardless of engine health - re-derive the threshold or improve retrieval, do not nudge it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(anime_retrieval_confidence_bucket[10m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(anime_retrieval_confidence_bucket[10m])))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
