    {
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "Redis keyspace hits vs misses. This is the SERVER view; the application's own response-cache hit rate is on the overview and is the one that maps to cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (instance) (rate(redis_keyspace_hits_total[10m])) / clamp_min(sum by (instance) (rate(redis_keyspace_hits_total[10m]) + rate(redis_keyspace_misses_total[10m])), 0.001)",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "description": "Against maxmemory (256mb locally, allkeys-lru). Hitting the ceiling is not an error - it silently starts evicting, which looks like a falling hit rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (redis_memory_used_bytes)",
          "legendFormat": "{{instance}}",
          "datasource": {
