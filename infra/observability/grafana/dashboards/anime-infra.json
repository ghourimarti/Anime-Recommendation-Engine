    {
      "type": "timeseries",
      "title": "Network by interface",
      "description": "Traffic on the Docker VM's interfaces. The br-* interfaces ARE the compose networks, so container-to-container traffic (api to postgres, collector to Langfuse) shows there, while eth0 is what leaves the machine: image pulls and hosted provider APIs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (interface) (rate(container_network_receive_bytes_total{id=\"/\"}[5m]))",
          "legendFormat": "{{interface}} rx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (interface) (rate(container_network_transmit_bytes_total{id=\"/\"}[5m]))",
          "legendFormat": "{{interface}} tx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
