    {
      "type": "timeseries",
      "title": "Containers vs whole VM: CPU",
      "description": "Cores burned by all containers together (/docker) against the whole VM (/). The gap is Docker Desktop's own overhead. NOTE: per-container breakdown is unavailable on this host. Docker Desktop's containerd image store leaves cAdvisor unable to identify containers, and it is not given the per-container cgroups either - it can only see the /docker cgroup as a whole. Turn off 'Use containerd for pulling and storing images' in Docker Desktop to get a per-container split; these same queries then gain a name label.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/docker\"}[5m]))",
          "legendFormat": "all containers",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/\"}[5m]))",
          "legendFormat": "whole VM",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/docker/buildkit\"}[5m]))",
          "legendFormat": "buildkit (image builds)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Containers vs whole VM: memory",
      "description": "Working-set memory for all containers together against the VM total. This is what the OOM killer looks at. NOTE: per-container breakdown is unavailable on this host. Docker Desktop's containerd image store leaves cAdvisor unable to identify containers, and it is not given the per-container cgroups either - it can only see the /docker cgroup as a whole. Turn off 'Use containerd for pulling and storing images' in Docker Desktop to get a per-container split; these same queries then gain a name label.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{id=\"/docker\"})",
          "legendFormat": "all containers",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(container_memory_working_set_bytes{id=\"/\"})",
          "legendFormat": "whole VM",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
